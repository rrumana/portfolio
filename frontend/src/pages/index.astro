---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/cards/ProjectCard.astro';
import ResearchCard from '../components/cards/ResearchCard.astro';
import MetricStrip from '../components/patterns/MetricStrip.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';
import { featuredProjects } from '../utils/projects';

const projects = featuredProjects(await getCollection('projects')).slice(0, 3);
const research = (await getCollection('research'))
  .sort((left, right) => left.data.featuredRank - right.data.featuredRank)
  .slice(0, 2);
---
<BaseLayout>
  <main id="main-content">
    <section class="section-shell home-hero">
      <div class="container home-hero__grid">
        <div class="home-hero__copy">
          <p class="eyebrow">{siteConfig.hero.eyebrow}</p>
          <h1>{siteConfig.hero.title}</h1>
          <p class="home-hero__lede">{siteConfig.hero.description}</p>
          <div class="home-hero__actions">
            <a class="button-link" href={siteConfig.hero.primaryCta.href}>{siteConfig.hero.primaryCta.label}</a>
            <a class="button-link button-link--ghost" href={siteConfig.hero.secondaryCta.href}>
              {siteConfig.hero.secondaryCta.label}
            </a>
          </div>
        </div>

        <aside class="home-hero__rail surface-panel">
          <div class="home-hero__rail-block">
            <p class="eyebrow">Current direction</p>
            <ul class="home-hero__focus">
              {siteConfig.focusAreas.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
        </div>
        <div class="home-hero__rail-block">
          <p class="eyebrow">How to explore</p>
          <p class="home-hero__note">
            Start with the selected projects below, then open a case study for architecture notes, implementation
            choices, interactive demos, and supporting references.
          </p>
        </div>
      </aside>
      </div>
    </section>

    <section class="section-shell">
      <div class="container section-grid">
        <div class="section-header">
          <div>
            <p class="eyebrow">Selected work</p>
            <h2>Selected projects</h2>
          </div>
          <a class="button-link button-link--ghost" href="/projects/">View all projects</a>
        </div>

        <div class="project-list project-list--home">
          {projects.map((project) => (
            <ProjectCard
              title={project.data.title}
              summary={project.data.summaryShort}
              href={`/projects/${project.id}/`}
              year={project.data.year}
              status={project.data.status}
              role={project.data.role}
              impact={project.data.impact}
              techStack={project.data.techStack}
              media={project.data.heroImage}
              mediaDark={project.data.heroImageDark}
              mediaAlt={project.data.heroAlt}
              repoUrl={project.data.repoUrl}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section-shell home-research">
      <div class="container section-grid">
        <div class="section-header">
          <div>
            <p class="eyebrow">Research</p>
            <h2>Whitepapers and technical reports</h2>
          </div>
          <a class="button-link button-link--ghost" href="/research/">View all research</a>
        </div>

        <div class="research-list research-list--home">
          {research.map((paper) => (
            <ResearchCard
              title={paper.data.shortTitle}
              summary={paper.data.summary}
              href={`/research/${paper.id}/`}
              kind={paper.data.kind}
              status={paper.data.status}
              displayDate={paper.data.displayDate}
              authors={paper.data.authors.map((author) => author.name)}
              topics={paper.data.topics}
              pdfUrl={paper.data.pdfUrl}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section-shell home-notes">
      <div class="container home-notes__section">
        <div class="home-notes__copy">
          <p class="eyebrow">Engineering approach</p>
          <h2>Systems thinking, operational discipline, and clear communication.</h2>
          <p>
            I care about the full path from an idea to a dependable system: explicit tradeoffs, reproducible builds,
            observable operation, and documentation that makes the result easier to maintain.
          </p>
        </div>
        <div class="home-notes__row">
          <MetricStrip items={siteConfig.homeMetrics} />
          <div class="surface-panel writing-card">
            <p class="eyebrow">Technical communication</p>
            <p>
              Technical writing is part of the engineering work. Research entries preserve authorship, citations,
              source artifacts, and limitations; case studies connect those results back to working software.
            </p>
            <p>
              The Reverse Game of Life work demonstrates that approach through a formal complexity result, a
              reproducible proof artifact, and a working WebAssembly sandbox.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
.home-hero__grid {
  display: grid;
  gap: 2rem;
  grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
  align-items: start;
}

.home-hero__copy {
  display: grid;
  gap: 1.35rem;
  max-width: 44rem;
}

.home-hero__lede {
  font-size: clamp(1.08rem, 0.45vw + 1rem, 1.28rem);
  max-width: 40rem;
  color: var(--color-text-muted);
}

.home-hero__actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.home-hero__rail {
  padding: 1.25rem;
  display: grid;
  gap: 1.1rem;
}

.home-hero__rail-block {
  display: grid;
  gap: 0.8rem;
}

.home-hero__focus {
  list-style: none;
  padding: 0;
  display: grid;
  gap: 0.55rem;
}

.home-hero__focus li {
  max-width: none;
  padding: 0.8rem 0.9rem;
  border-radius: var(--radius-sm);
  background: color-mix(in srgb, var(--color-surface-strong) 94%, transparent);
  border: 1px solid var(--color-border-subtle);
}

.home-hero__note {
  color: var(--color-text-muted);
}

.section-header {
  display: grid;
  gap: 1rem;
}

.section-header {
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
}

.project-list {
  display: grid;
  gap: 1rem;
}

.research-list {
  display: grid;
  gap: 1rem;
}

.project-list--home {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.research-list--home {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.home-notes__section,
.home-notes__copy {
  display: grid;
  gap: 1rem;
}

.home-notes__row {
  display: grid;
  gap: 1rem;
  grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
  align-items: start;
}

.writing-card {
  padding: 1.2rem;
  display: grid;
  gap: 0.8rem;
}

@media (max-width: 980px) {
  .home-hero__grid,
  .home-notes__row,
  .section-header {
    grid-template-columns: 1fr;
  }

  .project-list--home {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .research-list--home {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 720px) {
  .project-list--home {
    grid-template-columns: 1fr;
  }
}
</style>
