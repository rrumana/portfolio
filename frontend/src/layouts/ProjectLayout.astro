---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/shell/Container.astro';
import TechStackList from '../components/patterns/TechStackList.astro';
import type { ProjectSection } from '../components/projects';

export interface Action {
  label: string;
  href: string;
}

export interface Props {
  title: string;
  description: string;
  year: number;
  status: string;
  heroImage?: string;
  heroImageDark?: string;
  heroAlt?: string;
  techStack?: string[];
  actions?: Action[];
  navLinks?: readonly { href: string; label: string }[];
  sections?: ProjectSection[];
  toc?: { id: string; label: string }[];
}

const props = Astro.props as Props;
const {
  title,
  description,
  year,
  status,
  heroImage,
  heroImageDark,
  heroAlt,
  techStack = [],
  actions = [],
  navLinks = [],
  sections = [],
  toc = [],
} = props;

const sectionMap = new Map<string, string>();
if (toc.length === 0) {
  sectionMap.set('case-study', 'Overview');
}
for (const item of toc) {
  sectionMap.set(item.id, item.label);
}
for (const section of sections) {
  sectionMap.set(section.id, section.label);
  for (const anchor of section.anchors ?? []) {
    sectionMap.set(anchor.id, anchor.label);
  }
}

const sidebarItems = Array.from(sectionMap.entries()).map(([id, label]) => ({ href: `#${id}`, label }));
---
<BaseLayout title={`${title} | Ryan Rumana`} description={description} navLinks={navLinks}>
  <main id="main-content" class="project-page">
    <section class="project-shell section-shell">
      <Container class="project-layout">
        <header class="project-intro">
          <div class="project-intro__copy">
            <p class="eyebrow">Case study / {status} / {year}</p>
            <h1>{title}</h1>
            <p class="project-intro__description">{description}</p>
          </div>
        </header>

        {(actions.length > 0 || techStack.length > 0 || sidebarItems.length > 1) && (
          <aside class="project-sidebar">
            <div class="project-sidebar__panel surface-panel">
              {heroImage && (
                <section class="project-sidebar__block">
                  <div class="project-sidebar__media">
                    {heroImageDark ? (
                      <>
                        <img src={heroImage} alt={heroAlt ?? ''} class="project-sidebar__image project-sidebar__image--light" />
                        <img src={heroImageDark} alt={heroAlt ?? ''} class="project-sidebar__image project-sidebar__image--dark" />
                      </>
                    ) : (
                      <img src={heroImage} alt={heroAlt ?? ''} class="project-sidebar__image" />
                    )}
                  </div>
                </section>
              )}

              {sidebarItems.length > 1 && (
                <nav class="project-sidebar__block" aria-label="On this page">
                  <p class="project-sidebar__label">Contents</p>
                  <ul class="project-sidebar__toc">
                    {sidebarItems.map((item) => (
                      <li>
                        <a href={item.href}>{item.label}</a>
                      </li>
                    ))}
                  </ul>
                </nav>
              )}

              {techStack.length > 0 && (
                <section class="project-sidebar__block">
                  <p class="project-sidebar__label">Tech stack</p>
                  <TechStackList items={techStack} />
                </section>
              )}

              {actions.length > 0 && (
                <section class="project-sidebar__block">
                  <div class="project-sidebar__actions">
                    {actions.map((action, index) => (
                      <a
                        class={`button-link ${index > 0 ? 'button-link--ghost' : ''}`.trim()}
                        href={action.href}
                        target={action.href.startsWith('http') ? '_blank' : undefined}
                        rel={action.href.startsWith('http') ? 'noreferrer' : undefined}
                      >
                        {action.label}
                      </a>
                    ))}
                  </div>
                </section>
              )}
            </div>
          </aside>
        )}

        <article class="project-content prose">
          <section id={toc.length === 0 ? 'case-study' : undefined} class="section-grid">
            <slot />
          </section>
          {sections.map((section) => {
            const SectionComponent = section.component;
            return <SectionComponent {...(section.props ?? {})} />;
          })}
        </article>
      </Container>
    </section>
  </main>
</BaseLayout>

<style>
.project-shell {
  padding-top: 0;
}

.project-layout {
  display: grid;
  gap: 1.5rem 1.35rem;
  grid-template-columns: minmax(0, 1fr) minmax(230px, 272px);
  grid-template-areas:
    'intro sidebar'
    'content sidebar';
  align-items: start;
}

.project-intro {
  grid-area: intro;
}

.project-intro__copy {
  display: grid;
  gap: 1rem;
  max-width: 44rem;
}

.project-intro__description {
  font-size: clamp(1.08rem, 0.45vw + 1rem, 1.24rem);
  color: var(--color-text-muted);
  max-width: 38rem;
}

.project-sidebar {
  grid-area: sidebar;
  min-width: 0;
  position: sticky;
  top: var(--page-top-gap);
  align-self: start;
}

.project-sidebar__panel {
  position: static;
  padding: 0.85rem;
  display: grid;
  gap: 0.9rem;
}

.project-sidebar__block {
  display: grid;
  gap: 0.75rem;
}

.project-sidebar__block + .project-sidebar__block {
  padding-top: 1rem;
  border-top: 1px solid var(--color-border-subtle);
}

.project-sidebar__label {
  font-size: var(--font-size-xs);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-text-subtle);
}

.project-sidebar__media {
  overflow: hidden;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border-subtle);
  background:
    linear-gradient(180deg, color-mix(in srgb, var(--color-surface-strong) 82%, transparent), var(--color-surface));
}

.project-sidebar__image {
  width: 100%;
  aspect-ratio: 16 / 10;
  object-fit: contain;
}

.project-sidebar__image--dark {
  display: none;
}

html[data-theme='dark'] .project-sidebar__image--light {
  display: none;
}

html[data-theme='dark'] .project-sidebar__image--dark {
  display: block;
}

.project-sidebar__actions {
  display: grid;
  gap: 0.75rem;
}

.project-sidebar__actions .button-link {
  width: 100%;
}

.project-sidebar__toc {
  list-style: none;
  padding: 0;
  display: grid;
  gap: 0.25rem;
}

.project-sidebar__toc a {
  display: block;
  padding: 0.45rem 0;
  color: var(--color-text-muted);
}

.project-sidebar__toc a:hover,
.project-sidebar__toc a:focus-visible {
  color: var(--color-link);
}

.project-content {
  grid-area: content;
  min-width: 0;
  max-width: 50rem;
}

.project-content section {
  scroll-margin-top: 1.5rem;
}

@media (max-width: 1180px) {
  .project-intro__copy,
  .project-intro__description,
  .project-content {
    max-width: none;
  }
}

@media (max-width: 980px) {
  .project-layout {
    grid-template-columns: 1fr;
    grid-template-areas:
      'intro'
      'sidebar'
      'content';
  }

  .project-sidebar {
    position: static;
  }
}
</style>
