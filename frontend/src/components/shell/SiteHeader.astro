---
import Container from './Container.astro';
import PrimaryNav from '../navigation/PrimaryNav.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import { siteConfig } from '../../site.config';

export interface Props {
  navLinks?: readonly { href: string; label: string }[];
}

const props = Astro.props as Props;

const { navLinks = [] } = props;
---
<header class="site-header">
  <Container class="site-header__inner">
    <a class="site-header__brand" href="/">
      <strong>{siteConfig.name}</strong>
      <small>{siteConfig.role}</small>
    </a>
    <div class="site-header__right">
      <PrimaryNav links={navLinks} />
      <ThemeToggle />
    </div>
  </Container>
</header>

<style>
.site-header {
  position: static;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border-subtle);
}

.site-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  padding-block: 1.1rem 0.95rem;
}

.site-header__right {
  display: flex;
  align-items: center;
  gap: 1.25rem;
}

.site-header__brand {
  display: grid;
  gap: 0.12rem;
  line-height: 1;
  color: var(--color-text-strong);
}

.site-header__brand strong {
  font-family: var(--font-family-display);
  font-size: 1.38rem;
  font-weight: 600;
  letter-spacing: -0.03em;
}

.site-header__brand small {
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-text-subtle);
}

@media (max-width: 720px) {
  .site-header__inner {
    flex-direction: column;
    gap: 0.9rem;
    align-items: center;
    padding-block: 1rem;
  }

  .site-header__right {
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }

  .site-header__brand {
    justify-items: center;
    text-align: center;
  }
}
</style>
