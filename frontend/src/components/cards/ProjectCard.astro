---
export interface Props {
  title: string;
  summary: string;
  href: string;
  year: number;
  status: string;
  role: string;
  impact: string;
  techStack?: string[];
  media?: string;
  mediaDark?: string;
  mediaAlt?: string;
  repoUrl?: string;
}

const props = Astro.props as Props;
const {
  title,
  summary,
  href,
  year,
  status,
  role,
  impact,
  techStack = [],
  media,
  mediaDark,
  mediaAlt,
  repoUrl,
} = props;
---
<article class="project-card surface-panel">
  {media && (
    <a class="project-card__media" href={href} aria-label={`Open ${title}`}>
      {mediaDark ? (
        <>
          <img src={media} alt={mediaAlt ?? ''} loading="lazy" class="project-card__image project-card__image--light" />
          <img src={mediaDark} alt={mediaAlt ?? ''} loading="lazy" class="project-card__image project-card__image--dark" />
        </>
      ) : (
        <img src={media} alt={mediaAlt ?? ''} loading="lazy" class="project-card__image" />
      )}
    </a>
  )}

  <div class="project-card__header">
    <p class="project-card__meta">{status} / {year}</p>
    <p class="project-card__role">{role}</p>
  </div>

  <div class="project-card__body">
    <h3><a href={href}>{title}</a></h3>
    <p class="project-card__summary">{summary}</p>
    <p class="project-card__impact">{impact}</p>
  </div>

  {techStack.length > 0 && (
    <ul class="pill-list" aria-label="Technology stack">
      {techStack.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  )}

  <div class="project-card__actions">
    <a class="button-link" href={href}>Read case study</a>
    {repoUrl && (
      <a class="button-link button-link--ghost" href={repoUrl} target="_blank" rel="noreferrer">
        Repository
      </a>
    )}
  </div>
</article>

<style>
.project-card {
  display: grid;
  gap: 1rem;
  padding: 1.1rem;
  align-content: start;
}

.project-card__media {
  border-radius: calc(var(--radius-md) - 0.2rem);
  overflow: hidden;
  border: 1px solid var(--color-border-subtle);
  background:
    linear-gradient(135deg, color-mix(in srgb, var(--color-accent-500) 7%, var(--color-surface-strong)), var(--color-surface));
  aspect-ratio: 16 / 10;
}

.project-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
}

.project-card__image--dark {
  display: none;
}

html[data-theme='dark'] .project-card__image--light {
  display: none;
}

html[data-theme='dark'] .project-card__image--dark {
  display: block;
}

.project-card__header {
  display: flex;
  justify-content: space-between;
  gap: 0.9rem;
  flex-wrap: wrap;
}

.project-card__meta,
.project-card__role {
  font-size: var(--font-size-xs);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text-subtle);
}

.project-card__body {
  display: grid;
  gap: 0.6rem;
}

.project-card h3 {
  font-size: clamp(1.25rem, 0.7vw + 1rem, 1.6rem);
  font-family: var(--font-family-sans);
  font-weight: 700;
}

.project-card h3 a:hover,
.project-card h3 a:focus-visible {
  color: var(--color-accent-500);
}

.project-card__summary {
  font-size: 1rem;
  color: var(--color-text-default);
}

.project-card__impact {
  color: var(--color-text-muted);
  font-size: var(--font-size-sm);
}

.project-card__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}
</style>
