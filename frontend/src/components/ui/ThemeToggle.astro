---
import Icon from './Icon.astro';
---

<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme" aria-pressed="false">
  <span data-theme-sun><Icon name="sun" size={17} /></span>
  <span data-theme-moon hidden><Icon name="moon" size={17} /></span>
  <span data-theme-label>Light</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding-inline: 0.85rem;
    border: 1px solid var(--color-border-muted);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text-default);
    font-size: var(--font-size-sm);
    font-weight: 650;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    border-color: var(--color-primary-500);
    color: var(--color-text-strong);
  }

  .theme-toggle span { display: inline-flex; }
  .theme-toggle span[hidden] { display: none; }

  @media (max-width: 480px) {
    .theme-toggle { width: 2.75rem; padding: 0; }
    .theme-toggle [data-theme-label] { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  }
</style>
