---
export interface NavItem {
  href: string;
  label: string;
}

export interface Props {
  title?: string;
  items: NavItem[];
  collapseLabel?: string;
}

const props = Astro.props as Props;

const {
  title = 'On this page',
  items = [],
  collapseLabel = 'Navigate',
} = props;

const hasItems = items.length > 0;
---
{hasItems && (
  <aside class="sticky-nav">
    <nav class="sticky-nav__desktop surface-panel" aria-label={title}>
      <p class="sticky-nav__title">{title}</p>
      <ul class="sticky-nav__list">
        {items.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <details class="sticky-nav__mobile">
      <summary>{collapseLabel}</summary>
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </details>
  </aside>
)}

<style>
.sticky-nav {
  display: grid;
  gap: 0.75rem;
  position: sticky;
  top: 6.5rem;
  align-self: start;
}

.sticky-nav__desktop {
  display: grid;
  gap: 0.75rem;
  padding: 1rem;
}

.sticky-nav__title {
  font-size: var(--font-size-xs);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text-subtle);
}

.sticky-nav__list {
  list-style: none;
  padding: 0;
  display: grid;
  gap: 0.45rem;
}

.sticky-nav__list a {
  display: block;
  padding: 0.55rem 0.65rem;
  border-radius: var(--radius-sm);
  border: 1px solid transparent;
  color: var(--color-text-muted);
}

.sticky-nav__list a:hover,
.sticky-nav__list a:focus-visible {
  color: var(--color-text-strong);
  border-color: var(--color-border-subtle);
  background: color-mix(in srgb, var(--color-surface-strong) 90%, transparent);
}

.sticky-nav__mobile {
  display: none;
}

.sticky-nav__mobile summary {
  list-style: none;
  padding: 0.75rem 0.9rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-border-subtle);
  background: var(--color-surface-raised);
  font-weight: 600;
}

.sticky-nav__mobile summary::-webkit-details-marker {
  display: none;
}

.sticky-nav__mobile ul {
  list-style: none;
  padding: 0.5rem 0 0;
  display: grid;
  gap: 0.25rem;
}

.sticky-nav__mobile a {
  display: block;
  padding: 0.4rem 0;
  color: var(--color-text-muted);
}

.sticky-nav__mobile a:hover,
.sticky-nav__mobile a:focus-visible {
  color: var(--color-text-strong);
}

@media (max-width: 900px) {
  .sticky-nav {
    position: static;
  }

  .sticky-nav__desktop {
    display: none;
  }

  .sticky-nav__mobile {
    display: block;
  }
}
</style>
