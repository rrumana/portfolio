---
export interface LinkItem { href: string; label: string; }
export interface Props { links?: readonly LinkItem[]; }

const { links = [] } = Astro.props as Props;
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<nav class="primary-nav" aria-label="Main navigation">
  <ul>
    {links.map((link) => (
      <li><a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .primary-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 1.8vw, 1.4rem);
    padding: 0;
    list-style: none;
  }

  .primary-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    border-bottom: 2px solid transparent;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: 650;
    white-space: nowrap;
  }

  .primary-nav a:hover,
  .primary-nav a:focus-visible { color: var(--color-text-strong); }

  .primary-nav a[aria-current='page'] {
    border-color: var(--color-accent-warm);
    color: var(--color-text-strong);
  }

  @media (max-width: 760px) {
    .primary-nav { overflow-x: auto; scrollbar-width: none; }
    .primary-nav::-webkit-scrollbar { display: none; }
    .primary-nav ul { justify-content: space-between; gap: 0.6rem; }
    .primary-nav a { min-height: 2.4rem; font-size: 0.88rem; }
  }

  @media (max-width: 360px) {
    .primary-nav a { font-size: 0.82rem; }
  }
</style>
