---
import SectionShell from '../layout/SectionShell.astro';
import SurfaceCard from '../ui/SurfaceCard.astro';

export interface Props {
  id?: string;
}

const props = Astro.props as Props;
const { id = 'password-manager' } = props;
---
<SectionShell
  id={id}
  title="Rust Password Manager"
  description="An archived local CLI prototype for studying key derivation, encrypted persistence, and security review."
  accent
>
  <div class="grid">
    <SurfaceCard padding="lg" class="panel" id="crypto">
      <h3>Implemented pieces</h3>
      <ul>
        <li>Argon2-based master-password derivation.</li>
        <li>HKDF-SHA256 key expansion and AES-256-GCM-SIV encryption.</li>
        <li>Local SQLite and JSON persistence experiments.</li>
      </ul>
    </SurfaceCard>
    <SurfaceCard padding="lg" class="panel" id="api">
      <h3>What it is not</h3>
      <ul>
        <li>There is no server, WebAuthn flow, or production authentication API.</li>
        <li>The repository contains unresolved persistence and security problems.</li>
        <li>It should not be used to store real credentials.</li>
      </ul>
    </SurfaceCard>
    <SurfaceCard padding="lg" class="panel" id="roadmap">
      <h3>Why it remains public</h3>
      <p>
        The prototype is useful as an honest record of learning: security-sensitive code needs a much higher review bar than ordinary application software, and Rust alone cannot supply a safe design.
      </p>
      <a class="panel-link" href="https://github.com/rrumana/password-manager" target="_blank" rel="noopener noreferrer">
        View repository
      </a>
    </SurfaceCard>
  </div>
</SectionShell>

<style>
.grid {
  display: grid;
  gap: var(--space-xl);
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
}

.panel {
  display: grid;
  gap: var(--space-sm);
}

.panel ul {
  margin: 0;
  padding-left: 1.1rem;
  color: var(--color-text-muted);
  display: grid;
  gap: var(--space-2xs);
}

.panel-link {
  font-weight: 600;
  color: var(--color-primary-500);
  text-decoration: none;
}

.panel-link:hover,
.panel-link:focus-visible {
  text-decoration: underline;
}
</style>
