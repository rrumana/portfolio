---
import katex from 'katex';

export interface Props {
  expression: string;
  caption?: string;
  inline?: boolean;
  class?: string;
}

const props = Astro.props as Props;
const { expression, caption, inline = false, class: className = '' } = props;

const rendered = katex.renderToString(expression, {
  displayMode: !inline,
  throwOnError: false,
  strict: 'ignore',
});
---
{inline ? (
  <span class={`math-inline ${className}`.trim()} set:html={rendered} />
) : (
  <figure class={`math-block ${className}`.trim()}>
    <div class="math-block__formula" set:html={rendered} />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
)}

<style>
.math-inline {
  display: inline-flex;
  align-items: center;
  padding-inline: 0.35rem;
  border-radius: 999px;
  background: color-mix(in srgb, var(--color-accent-500) 10%, transparent);
}

.math-block {
  display: grid;
  gap: 0.75rem;
  margin: 0;
  padding: 1.25rem 1.5rem;
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-lg);
  background:
    linear-gradient(135deg, color-mix(in srgb, var(--color-accent-500) 10%, transparent), transparent 45%),
    var(--color-surface-raised);
  box-shadow: var(--shadow-soft);
}

.math-block__formula {
  overflow-x: auto;
  padding-bottom: 0.15rem;
}

.math-block__formula :global(.katex-display) {
  margin: 0;
}

.math-block figcaption {
  font-size: var(--font-size-xs);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--color-text-subtle);
}
</style>
